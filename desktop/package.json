{
  "name": "nous",
  "version": "0.1.0",
  "description": "Nous — personal knowledge and autonomous research",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "icons:generate": "python3 scripts/generate_macos_icon.py && ./node_modules/.bin/tauri icon app-icon.png -o src-tauri/icons",
    "sync:macos-app": "bash scripts/sync_macos_app_bundle.sh",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.22.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tiptap/core": "^3.27.1",
    "@tiptap/html": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "force-graph": "^1.51.4",
    "fuse.js": "^7.4.2",
    "marked": "^18.0.5",
    "pdfjs-dist": "^6.0.227",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
