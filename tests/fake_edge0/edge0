#!/usr/bin/env python3
from __future__ import annotations

import json
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


def _parse(argv: list[str]) -> tuple[int, list[str]]:
    port = 0
    ids = ["edge0-8b"]
    for i, arg in enumerate(argv):
        if arg == "--port":
            port = int(argv[i + 1])
        elif arg == "--serve-id":
            ids = [part for part in argv[i + 1].split(",") if part]
    return port, ids


def main() -> int:
    argv = sys.argv[1:]
    if "--die" in argv:
        print("edge0: failed to load checkpoint", file=sys.stderr, flush=True)
        return 3

    port, ids = _parse(argv)
    payload = json.dumps(
        {
            "object": "list",
            "data": [
                {"id": i, "object": "model", "created": 0, "owned_by": "edge0"} for i in ids
            ],
        }
    ).encode()

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:  # noqa: N802
            if self.path != "/v1/models":
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

        def log_message(self, *_args: object) -> None:
            pass

    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
