# LLM provider (BYOK): groq | ollama | openai | xai | openrouter | openai_compatible
LLM_PROVIDER=groq
# Preferred generic key (works for any cloud provider). Groq also accepts GROQ_API_KEY.
LLM_API_KEY=
GROQ_API_KEY=
# Required when LLM_PROVIDER=openai_compatible (e.g. https://api.openai.com/v1)
LLM_BASE_URL=
GROQ_MAX_TOKENS=4096
LLM_MAX_TOKENS=4096
# Main (heavy) model — planner + synthesizer. Prefer a stable paid/reliable model for demos.
LLM_MODEL=openai/gpt-oss-120b
# Optional light model — Ask + verifier (+ analyst). Empty = use LLM_MODEL.
LLM_FAST_MODEL=
# Fallback used automatically on rate limits
GROQ_FALLBACK_MODEL=qwen/qwen3-32b
LLM_FALLBACK_MODEL=

# Internal: Gemini Flash-Lite for chat rename + Auto mode routing (not in Settings UI).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
SESSION_TITLE_MODEL=gemini-3.5-flash-lite

# Embeddings (vault search). Default is bundled local — Ollama NOT required.
# fastembed | ollama | openai_compatible
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Only for openai_compatible embeddings (optional overrides)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Optional: local Ollama chat and/or ollama embeddings
OLLAMA_BASE_URL=http://localhost:11434

CHROMA_PATH=data/chroma
COLLECTION_NAME=personal_knowledge
RETRIEVAL_TOP_K=5
RETRIEVAL_TOP_K_PER_QUERY=5
# Keep revise loops tight by default (token cost)
MAX_REVISIONS=1
TAVILY_API_KEY=
ENABLE_WEB_SEARCH=true
ENABLE_ARXIV=true
# Optional Notion connector (read-only). Off by default — vault stays local-first.
ENABLE_MCP=false
NOTION_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
ARXIV_MAX_RESULTS=3
HYBRID_FALLBACK_THRESHOLD=2

# Agent layer (memory + goal loops around LangGraph)
AUTO_MEMORY=true
AUTO_RECALL=true
MAX_GOAL_PASSES=2
WATCH_MAX_PASSES=1
MIN_GOAL_CONFIDENCE=0.65
AGENT_MODE_DEFAULT=goal
PLAN_REVIEW_DEFAULT=true
# Daily autonomous review (in-app; auto catch-up only after DAILY_REVIEW_HOUR)
DAILY_REVIEW_ENABLED=true
DAILY_REVIEW_HOUR=9
DAILY_REVIEW_MAX_GOALS=2
DAILY_REVIEW_CATCH_UP=true

# Ablation: set false to disable verifier→analyst revision loops (eval)
ENABLE_SELF_CRITIQUE=true

# Optional Cloud Watch (hosted). Operator-only — hidden from Settings UI.
# Set this on machines you ship so users get the welcome sign-in screen.
CLOUD_WATCH_URL=
# Local/dev server secrets (required to run cloud-watch/ via Docker or uvicorn)
CLOUD_WATCH_CRON_TOKEN=
CLOUD_WATCH_SECRET=
# Session token written automatically after sign-in (do not paste manually).
CLOUD_WATCH_USER_TOKEN=
