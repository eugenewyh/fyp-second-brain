# Postgres (Neon or local). Required.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/nous_auth

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-char-secret
BETTER_AUTH_URL=http://localhost:3000
PORT=3000

# Comma-separated origins allowed to call auth (desktop + tauri)
TRUSTED_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost

# Shared secret for Cloud Watch → GET /internal/session
AUTH_INTERNAL_SECRET=change-me-internal-secret

# Resend (optional in local — OTP logged to stdout when missing)
RESEND_API_KEY=
RESEND_FROM=Nous <noreply@yourdomain.com>
AUTH_DEV_LOG_OTP=1
