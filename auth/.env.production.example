# Production auth (Render + Neon + Resend). Copy values into Render → Environment.
# Do not commit real secrets.

# Neon — use the *pooled* connection string (ends with -pooler.neon.tech)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Must match your Render service URL exactly (no trailing slash)
BETTER_AUTH_URL=https://nous-auth.onrender.com

# Render sets PORT automatically; local override only
PORT=10000

TRUSTED_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost

# Generate: openssl rand -hex 24 — same value in repo root .env for Cloud Watch
AUTH_INTERNAL_SECRET=

# Resend — verified domain required for arbitrary recipients
RESEND_API_KEY=re_...
RESEND_FROM=Nous <noreply@yourdomain.com>

# Disable stdout OTP in production
AUTH_DEV_LOG_OTP=0
